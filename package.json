{
  "name": "you-define-tube",
  "displayName": "YouDefineTube: Focus & Limit YouTube",
  "version": "1.1.0",
  "description": "Redefine your YouTube experience. Block addictive distractions, set daily limits, and track your time for better focus.",
  "author": "Purva",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 PARCEL_WORKERS=1 plasmo dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 plasmo build",
    "package": "plasmo package",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitest/coverage-v8": "^3.2.4",
    "baseline-browser-mapping": "^2.10.29",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^3.2.4"
  },
  "manifest": {
    "permissions": [
      "notifications",
      "alarms",
      "storage",
      "activeTab"
    ],
    "developer": {
      "name": "Purva",
      "url": "https://github.com/Purva0017/YouDefineTube"
    },
    "host_permissions": [
      "https://www.youtube.com/*",
      "https://m.youtube.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "you-define-tube@purva.patel",
        "strict_min_version": "109.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
